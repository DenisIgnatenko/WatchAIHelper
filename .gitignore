# Secrets - never commit real environment files
.env
*.env
!*.env.example

# macOS
.DS_Store

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
build/

# Local signing overrides (each developer uses their own Apple team)
Signing.local.xcconfig

# Python / tooling caches
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/

# Generated by XcodeGen from apple/project.yml
apple/*.xcodeproj/

# SwiftPM build output
.build/
.swiftpm/

# Maven build output
target/
