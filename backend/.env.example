# Backend environment template.
# Copy to backend/.env and fill in real values. backend/.env is git-ignored.
# Never commit real secrets. Never put these values into the iOS/watchOS apps.

# --- OpenAI ---
# Project-scoped API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model identifier. Single place of configuration (spec section 33).
# Candidates (docs/architecture.md, section 15): gpt-6-sol (default), gpt-6-astra.
OPENAI_MODEL=gpt-6-sol
# Reasoning effort: lower is faster. Speed is UX priority #1.
OPENAI_REASONING_EFFORT=low
# Image preprocessing level: low | high | original | auto (model dependent).
OPENAI_IMAGE_DETAIL=high
# Whether OpenAI may store response objects on their side (Responses API "store").
# false: the backend builds conversation context itself (backend is the source of truth).
OPENAI_STORE=false

# --- Client authentication ---
# Bootstrap bearer token for the first (owner) device set.
# Generate with: openssl rand -hex 32
CLIENT_API_TOKEN=

# --- Persistence ---
# JDBC connection. Local development: backend/compose.dev.yaml starts PostgreSQL on localhost.
DB_URL=jdbc:postgresql://localhost:5432/copilot
DB_USER=copilot
DB_PASSWORD=copilot

# --- Retention policy (spec section 47) ---
# How many days original images are kept before automatic deletion.
IMAGE_RETENTION_DAYS=30
# A registered attachment whose bytes do not arrive within this time becomes FAILED
# (for example after the iPhone app was force-quit). Prevents waiting forever.
ATTACHMENT_UPLOAD_TIMEOUT_MINUTES=10
